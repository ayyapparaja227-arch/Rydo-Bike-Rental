# =================================================================
# Rydo Environment Configuration Example
# Copy this file to .env and adjust values for your environment
# =================================================================

# MySQL Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/rydodb?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# Brevo Mail (SMTP) Credentials
BREVO_MAIL_USERNAME=your_email@example.com
BREVO_MAIL_PASSWORD=your_brevo_smtp_key

# Fast2SMS OTP Configuration
FAST2SMS_API_KEY=your_fast2sms_api_key
